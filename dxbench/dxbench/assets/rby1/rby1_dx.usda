#usda 1.0
(
    customLayerData = {
        string generator = "dxbench/assets/rby1/make_rby1_usd.py"
        string source = "rby1_fullbody_collision.usd"
    }
    defaultPrim = "RBY1"
    metersPerUnit = 1
    subLayers = [
        @../../../../submodules/rby1-sim-isaac/assets/generated/rby1_fullbody_collision.usd@
    ]
    upAxis = "Z"
)

over "RBY1" (
    delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    over "joints"
    {
        def PhysicsRevoluteJoint "left_wheel" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        def PhysicsRevoluteJoint "right_wheel" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        def PhysicsRevoluteJoint "torso_0" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        def PhysicsRevoluteJoint "torso_1" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        def PhysicsRevoluteJoint "torso_2" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        def PhysicsRevoluteJoint "torso_3" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        def PhysicsRevoluteJoint "torso_4" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        def PhysicsRevoluteJoint "torso_5" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        def PhysicsRevoluteJoint "head_0" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        def PhysicsRevoluteJoint "head_1" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        over "fixed_base" (
            active = false
        )
        {
        }
    }

    over "base" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0

        over "collisions"
        {
            over "mesh_0"
            {
                over "cylinder" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </RBY1/PhysicsMaterials/caster> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                }
            }

            over "mesh_1"
            {
                over "cylinder" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </RBY1/PhysicsMaterials/caster> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                }
            }

            over "mesh_2"
            {
                over "cylinder" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </RBY1/PhysicsMaterials/caster> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                }
            }

            over "mesh_3"
            {
                over "cylinder" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </RBY1/PhysicsMaterials/caster> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                }
            }
        }
    }

    def "PhysicsMaterials"
    {
        def Material "wheel" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1.2
            float physics:restitution = 0
            float physics:staticFriction = 1.2
            uniform token physxMaterial:frictionCombineMode = "average"
        }

        def Material "caster" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0
            float physics:restitution = 0
            float physics:staticFriction = 0
            uniform token physxMaterial:frictionCombineMode = "min"
        }
    }

    over "wheel_l"
    {
        over "collisions"
        {
            over "mesh_0"
            {
                over "cylinder" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </RBY1/PhysicsMaterials/wheel> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                }
            }
        }
    }

    over "wheel_r"
    {
        over "collisions"
        {
            over "mesh_0"
            {
                over "cylinder" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </RBY1/PhysicsMaterials/wheel> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                }
            }
        }
    }

